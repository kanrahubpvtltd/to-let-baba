# Supabase Configuration for To-Let Baba
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: Even without Supabase keys, To-Let Baba includes a fully functional,
# rich offline/mock-data layer with localStorage persistence out of the box!
